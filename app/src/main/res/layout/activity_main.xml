<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".activities.MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:titleTextAppearance="@style/TextAppearance.App.Headline6"
            app:title="@string/app_name"
            app:menu="@menu/main_menu"
            style="@style/App.Toolbar" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Cabecera con avatar y bienvenida -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWelcome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurface"
                android:layout_marginBottom="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:contentPadding="16dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvBienvenida"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/welcome_user"
                        android:textAppearance="?attr/textAppearanceHeadline6"
                        android:textColor="@color/colorOnSurface"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/ivUserAvatar"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvSubtitulo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/welcome_subtitle"
                        android:textAppearance="?attr/textAppearanceBody2"
                        android:textColor="@color/gray_600"
                        app:layout_constraintTop_toBottomOf="@id/tvBienvenida"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/ivUserAvatar"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="8dp" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivUserAvatar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/user_avatar_desc"
                        android:src="@drawable/ic_user_avatar"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:shapeAppearanceOverlay="@style/CircleImageView"
                        app:strokeColor="@color/colorPrimary"
                        app:strokeWidth="2dp" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Título de sección -->
            <TextView
                android:id="@+id/tvMenuTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/main_menu_title"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                android:textStyle="bold"
                android:textColor="@color/colorOnBackground"
                app:layout_constraintTop_toBottomOf="@id/cardWelcome"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <!-- Grid Menu con CardView mejorados -->
            <GridLayout
                android:id="@+id/gridMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="true"
                app:layout_constraintTop_toBottomOf="@id/tvMenuTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp">

                <!-- Pedidos -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPedidos"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/card_pedidos"
                    android:clickable="true"
                    android:focusable="true"
                    app:strokeWidth="0dp"
                    app:rippleColor="@color/white"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:src="@drawable/ic_orders"
                            android:contentDescription="@string/orders_desc"
                            app:tint="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/menu_orders"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_marginTop="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/orders_subtitle"
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:alpha="0.8"
                            android:layout_marginTop="4dp"
                            android:gravity="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Mapa -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMapa"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/card_mapa"
                    android:clickable="true"
                    android:focusable="true"
                    app:strokeWidth="0dp"
                    app:rippleColor="@color/white"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:src="@drawable/ic_map"
                            android:contentDescription="@string/map_desc"
                            app:tint="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/menu_map"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_marginTop="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/map_subtitle"
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:alpha="0.8"
                            android:layout_marginTop="4dp"
                            android:gravity="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Reportes -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReportes"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/card_reportes"
                    android:clickable="true"
                    android:focusable="true"
                    app:strokeWidth="0dp"
                    app:rippleColor="@color/white"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:src="@drawable/ic_reports"
                            android:contentDescription="@string/reports_desc"
                            app:tint="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/menu_reports"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_marginTop="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reports_subtitle"
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:alpha="0.8"
                            android:layout_marginTop="4dp"
                            android:gravity="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Incidencias -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardIncidencias"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/card_incidencias"
                    android:clickable="true"
                    android:focusable="true"
                    app:strokeWidth="0dp"
                    app:rippleColor="@color/white"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:src="@drawable/ic_incidents"
                            android:contentDescription="@string/incidents_desc"
                            app:tint="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/menu_incidents"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_marginTop="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/incidents_subtitle"
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:alpha="0.8"
                            android:layout_marginTop="4dp"
                            android:gravity="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FAB para acción principal con transición mejorada -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/new_order"
        android:textColor="@color/white"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/white"
        app:backgroundTint="@color/colorPrimary"
        app:elevation="6dp"
        android:contentDescription="@string/new_order_desc" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>