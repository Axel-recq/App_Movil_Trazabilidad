<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".activities.DetallePedidoActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/detalle_pedido"
            app:titleTextColor="@color/colorOnPrimary"
            style="@style/App.Toolbar" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="80dp">

            <!-- Tarjeta de información del pedido -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInfoPedido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                style="@style/App.CardView">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- Número de pedido -->
                    <TextView
                        android:id="@+id/tvNumeroPedido"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/pedido_numero"
                        android:textAppearance="?attr/textAppearanceHeadline6"
                        android:textColor="@color/colorPrimary"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/chipEstado" />

                    <!-- Chip para el estado -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipEstado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ASIGNADO"
                        android:textColor="@color/white"
                        app:chipBackgroundColor="@color/colorPrimary"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Línea separadora -->
                    <View
                        android:id="@+id/divider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_300"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/tvNumeroPedido" />

                    <!-- Cliente -->
                    <ImageView
                        android:id="@+id/icCliente"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/divider"
                        app:layout_constraintStart_toStartOf="parent"
                        app:tint="@color/colorPrimary" />

                    <TextView
                        android:id="@+id/tvCliente"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/cliente"
                        android:textAppearance="?attr/textAppearanceBody1"
                        android:layout_marginStart="8dp"
                        app:layout_constraintTop_toTopOf="@id/icCliente"
                        app:layout_constraintBottom_toBottomOf="@id/icCliente"
                        app:layout_constraintStart_toEndOf="@id/icCliente"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Dirección -->
                    <ImageView
                        android:id="@+id/icDireccion"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_dialog_map"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/tvCliente"
                        app:layout_constraintStart_toStartOf="parent"
                        app:tint="@color/colorPrimary" />

                    <TextView
                        android:id="@+id/tvDireccion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/direccion"
                        android:textAppearance="?attr/textAppearanceBody1"
                        android:layout_marginStart="8dp"
                        app:layout_constraintTop_toTopOf="@id/icDireccion"
                        app:layout_constraintBottom_toBottomOf="@id/icDireccion"
                        app:layout_constraintStart_toEndOf="@id/icDireccion"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Fecha -->
                    <ImageView
                        android:id="@+id/icFecha"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/tvDireccion"
                        app:layout_constraintStart_toStartOf="parent"
                        app:tint="@color/colorPrimary" />

                    <TextView
                        android:id="@+id/tvFecha"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/fecha"
                        android:textAppearance="?attr/textAppearanceBody1"
                        android:layout_marginStart="8dp"
                        app:layout_constraintTop_toTopOf="@id/icFecha"
                        app:layout_constraintBottom_toBottomOf="@id/icFecha"
                        app:layout_constraintStart_toEndOf="@id/icFecha"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Estado oculto para mantener compatibilidad -->
                    <TextView
                        android:id="@+id/tvEstado"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Título de la sección de productos -->
            <TextView
                android:id="@+id/tvProductosTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Productos"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/cardInfoPedido"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Tarjeta de productos -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProductos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvProductosTitulo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                style="@style/App.CardView">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerProductos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingVertical="8dp"
                    tools:listitem="@android:layout/simple_list_item_2"
                    tools:itemCount="3" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:indeterminateTint="@color/colorPrimary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Tarjeta flotante para los botones de acción -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBotones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardElevation="8dp"
        app:cardCornerRadius="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerMapa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ver_mapa"
                android:layout_marginEnd="8dp"
                app:icon="@android:drawable/ic_dialog_map"
                style="@style/App.Button.Outlined" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEntregado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/entregado"
                android:layout_marginEnd="8dp"
                app:icon="@android:drawable/ic_menu_send"
                style="@style/App.Button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIncidencia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/incidencia"
                app:icon="@android:drawable/ic_dialog_alert"
                style="@style/App.Button.Text" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>