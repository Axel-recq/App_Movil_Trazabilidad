<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".activities.DetallePedidoActivity">

    <!-- AppBar con CollapsingToolbarLayout para efectos de desplazamiento -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentScrim="@color/colorPrimary"
            app:expandedTitleTextAppearance="@style/TextAppearance.App.Headline5"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                style="@style/App.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:title="@string/detalle_pedido"
                app:titleTextColor="@color/colorOnPrimary" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Contenido principal con NestedScrollView -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Tarjeta de información del pedido con elevación y bordes redondeados -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInfoPedido"
                style="@style/App.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/colorAccent"
                app:strokeWidth="0.5dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- Encabezado del pedido con diseño más prominente -->
                    <TextView
                        android:id="@+id/tvNumeroPedido"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/pedido_numero"
                        android:textAppearance="@style/TextAppearance.App.HeadlineSmall"
                        android:textColor="@color/colorPrimary"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@+id/chipEstado"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Chip de estado con animación de transición de color y sombra -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipEstado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:elevation="2dp"
                        android:text="ASIGNADO"
                        android:textColor="@color/colorOnPrimary"
                        android:textStyle="bold"
                        app:chipBackgroundColor="@color/colorPrimary"
                        app:chipMinHeight="32dp"
                        app:chipStartPadding="12dp"
                        app:chipEndPadding="12dp"
                        app:ensureMinTouchTargetSize="true"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Divisor con gradiente mejorado -->
                    <View
                        android:id="@+id/divider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="@color/colorAccent"
                        android:alpha="0.5"
                        app:layout_constraintTop_toBottomOf="@id/tvNumeroPedido" />

                    <!-- Información del cliente con iconos mejorados y diseño más limpio -->
                    <LinearLayout
                        android:id="@+id/clienteContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        app:layout_constraintTop_toBottomOf="@id/divider">

                        <ImageView
                            android:id="@+id/icCliente"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/cliente_hint"
                            android:src="@drawable/ic_person"
                            app:tint="@color/colorPrimary" />

                        <TextView
                            android:id="@+id/tvCliente"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/cliente"
                            android:textAppearance="@style/TextAppearance.App.TitleMedium" />
                    </LinearLayout>

                    <!-- Dirección con iconos en contenedor para mejor alineación -->
                    <LinearLayout
                        android:id="@+id/direccionContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        app:layout_constraintTop_toBottomOf="@id/clienteContainer">

                        <ImageView
                            android:id="@+id/icDireccion"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/direccion_hint"
                            android:src="@drawable/ic_map"
                            app:tint="@color/colorPrimary" />

                        <TextView
                            android:id="@+id/tvDireccion"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/direccion"
                            android:textAppearance="@style/TextAppearance.App.Body1" />
                    </LinearLayout>

                    <!-- Fecha con iconos en contenedor para mejor alineación -->
                    <LinearLayout
                        android:id="@+id/fechaContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        app:layout_constraintTop_toBottomOf="@id/direccionContainer">

                        <ImageView
                            android:id="@+id/icFecha"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/fecha_reporte"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/colorPrimary" />

                        <TextView
                            android:id="@+id/tvFecha"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/fecha"
                            android:textAppearance="@style/TextAppearance.App.Body1" />
                    </LinearLayout>

                    <!-- Estado oculto para mantener compatibilidad -->
                    <TextView
                        android:id="@+id/tvEstado"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Título de sección de productos con estilo moderno y diseño mejorado -->
            <LinearLayout
                android:id="@+id/productosHeaderContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/cardInfoPedido">

                <ImageView
                    android:id="@+id/icProductos"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="Productos"
                    android:src="@drawable/ic_empty_orders"
                    app:tint="@color/colorPrimary" />

                <TextView
                    android:id="@+id/tvProductosTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Productos"
                    android:textAppearance="@style/TextAppearance.App.HeadlineSmall"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold" />

                <!-- Contador de productos con estilo mejorado -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipProductCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="0"
                    android:textColor="@color/colorOnPrimary"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/colorSecondary"
                    app:chipMinHeight="24dp"
                    app:ensureMinTouchTargetSize="false" />
            </LinearLayout>

            <!-- Lista de productos con efecto de elevación y bordes mejorados -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProductos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@color/colorAccent"
                app:strokeWidth="0.5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/productosHeaderContainer">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- RecyclerView con decoración y animación -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerProductos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:paddingVertical="8dp"
                        android:scrollbars="none"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_producto" />

                    <!-- Estado vacío mejorado con animación -->
                    <LinearLayout
                        android:id="@+id/emptyProductsView"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:contentDescription="No hay productos"
                            android:src="@drawable/ic_empty_box"
                            app:tint="@color/colorSecondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="No hay productos en este pedido"
                            android:textAppearance="@style/TextAppearance.App.Body1"
                            android:textColor="@color/gray_600" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra de acción flotante con elevación dinámica y diseño mejorado -->
    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottomAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:backgroundTint="@color/colorSurface"
        app:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- Botón Ver Mapa con icono moderno y estilo mejorado -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerMapa"
                style="@style/App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/ver_mapa"
                android:textAllCaps="false"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_map"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="20dp"
                app:iconTint="@color/colorPrimary" />

            <!-- Botón Entregado con icono animado y estilo prominente -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEntregado"
                style="@style/App.Button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1.2"
                android:text="@string/entregado"
                android:textAllCaps="false"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_check_circle"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="20dp" />

            <!-- Botón Incidencia con icono de alerta y estilo de advertencia -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIncidencia"
                style="@style/App.Button.Text"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/incidencia"
                android:textAllCaps="false"
                android:textColor="@color/error"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_warning"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="20dp"
                app:iconTint="@color/error" />
        </LinearLayout>
    </com.google.android.material.bottomappbar.BottomAppBar>

    <!-- Progress indicator mejorado con contenedor semitransparente -->
    <FrameLayout
        android:id="@+id/loadingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/colorPrimary"
            app:indicatorSize="48dp"
            app:trackColor="@color/colorAccent"
            app:trackThickness="4dp" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>