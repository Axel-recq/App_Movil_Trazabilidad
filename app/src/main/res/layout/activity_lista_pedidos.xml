<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    tools:context=".activities.ListaPedidosActivity">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical"
android:padding="16dp"> <!-- Agregar padding para separación -->

<!-- ProgressBar -->
<ProgressBar
    android:id="@+id/progressBar"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:visibility="gone"
    android:contentDescription="@string/loading_content_description" /> <!-- Descripción de accesibilidad -->

<!-- TextView de vacio -->
<TextView
    android:id="@+id/tvEmpty"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="No hay pedidos"
    android:gravity="center"
    android:visibility="gone"
    android:padding="16dp"
    android:contentDescription="@string/no_orders_description" /> <!-- Descripción de accesibilidad -->

<!-- ListView -->
<ListView
    android:id="@+id/listViewPedidos"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:divider="@android:color/darker_gray"
    android:dividerHeight="0.5dp"
    android:scrollingCache="false"
    android:contentDescription="@string/orders_list_description" /> <!-- Descripción de accesibilidad -->

</LinearLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
